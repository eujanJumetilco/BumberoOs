# Copy this file to ".env" (same folder as pom.xml) and fill in your Neon details.
# .env is gitignored, so your password will not be pushed.
# Neon dashboard -> Connect -> copy host, database, user, password.
DB_URL=jdbc:postgresql://YOUR-HOST.neon.tech/YOUR_DB?sslmode=require
DB_USERNAME=YOUR_USERNAME
DB_PASSWORD=YOUR_PASSWORD
