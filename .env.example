# Copy this file to ".env" (same folder as pom.xml) and fill in your Neon details.
# .env is gitignored, so your password will not be pushed.
# Neon dashboard -> Connect -> copy host, database, user, password.
DB_URL=jdbc:postgresql://YOUR-HOST.neon.tech/YOUR_DB?sslmode=require
DB_USERNAME=YOUR_USERNAME
DB_PASSWORD=YOUR_PASSWORD

# Optional. On a host such as Railway, set these as environment variables instead.
# SESSION_COOKIE_SECURE=true          # required when the site is served over HTTPS
# SHOW_SQL=true                       # print every SQL statement
# CORS_ALLOWED_ORIGINS=http://localhost:3000   # comma-separated; only for browsers calling the API directly
